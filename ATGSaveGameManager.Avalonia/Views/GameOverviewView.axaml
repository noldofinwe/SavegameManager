<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:atgSaveGameManager="clr-namespace:ATGSaveGameManager"
             xmlns:viewModel="clr-namespace:ATGSaveGameManager.ViewModel"
             xmlns:views="clr-namespace:ATGSaveGameManager.Avalonia.Views"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:DataType="viewModel:GameOverviewViewModel"
             x:Class="ATGSaveGameManager.Avalonia.Views.GameOverviewView">
        <UserControl.Resources>
        <atgSaveGameManager:EnumToStringConverter x:Key="DefaultEnumToStringConverter"/>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="30" />
        </Grid.RowDefinitions>
        <DataGrid ItemsSource="{Binding GameList}"
          Grid.Row="0"
          Grid.ColumnSpan="2"
          AutoGenerateColumns="False"
          HeadersVisibility="Column"
          GridLinesVisibility="None"
          RowHeight="32">

    <!-- Row highlight when IsYourTurn = true -->
    <!-- <DataGrid.RowStyle> -->
    <!--     <Style Selector="DataGridRow"> -->
    <!--         <Style.Triggers> -->
    <!--             <DataTrigger Binding="{Binding IsYourTurn}" Value="True"> -->
    <!--                 <Setter Property="Background" Value="LightGreen"/> -->
    <!--             </DataTrigger> -->
    <!--         </Style.Triggers> -->
    <!--     </Style> -->
    <!-- </DataGrid.RowStyle> -->

    <DataGrid.Columns>

        <!-- Icon column -->
        <DataGridTemplateColumn Width="40">
            <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                    <Image Source="{Binding IconImage}"
                           Width="24"
                           Height="24"
                           Stretch="Fill"/>
                </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>

        <!-- Name -->
        <DataGridTextColumn Header="Name"
                            Width="150"
                            Binding="{Binding Model.Name}" />

        <!-- Sync status -->
        <DataGridTextColumn Header="Sync status"
                            Width="125"
                            Binding="{Binding Status}" />

        <!-- Current turn --><!--
        <DataGridTextColumn Header="Current turn"
                            Width="75"
                            Binding="{Binding Model.CurrentTurn}" />-->

        <!-- Current player -->
        <DataGridTextColumn Header="Current player"
                            Width="100"
                            Binding="{Binding NextPlayer}" />

        <!-- Last turn -->
        <DataGridTextColumn Header="Last Turn"
                            Width="200"
                            Binding="{Binding LastTurnTimeString}" />

        <!-- Player checkbox -->
      <DataGridTemplateColumn Header="Subscribe">
        <DataGridTemplateColumn.CellTemplate>
          <DataTemplate>
              <StackPanel>
              <Button Content="Subscribe" IsVisible="{Binding !Model.Subscribed}"
                      Command="{Binding ((viewModel:GameOverviewViewModel)DataContext).SubscribeToGame,
                                      RelativeSource={RelativeSource AncestorType=views:GameOverviewView}}"
                      CommandParameter="{Binding Model.Id}" />
              <CheckBox IsVisible="{Binding Model.Subscribed}" IsChecked="True" IsEnabled="False"></CheckBox>
              </StackPanel>
          </DataTemplate>
        </DataGridTemplateColumn.CellTemplate>
      </DataGridTemplateColumn>
      <DataGridTemplateColumn Header="Finish Turn">
        <DataGridTemplateColumn.CellTemplate>
          <DataTemplate>
            <Button Content="Upload"
                    Command="{Binding ((viewModel:GameOverviewViewModel)DataContext).UploadNewFile,
                                      RelativeSource={RelativeSource AncestorType=views:GameOverviewView}}"
                    CommandParameter="{Binding Model.Id}" />
          </DataTemplate>
        </DataGridTemplateColumn.CellTemplate>
      </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="Delete">
            <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                    <Button Content="Delete"
                            Command="{Binding ((viewModel:GameOverviewViewModel)DataContext).Delete,
                                      RelativeSource={RelativeSource AncestorType=views:GameOverviewView}}"
                            CommandParameter="{Binding Model.Id}" />
                </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
      <DataGridTemplateColumn Header="Download">
        <DataGridTemplateColumn.CellTemplate>
          <DataTemplate>
            <Button Content="Delete"
                    Command="{Binding ((viewModel:GameOverviewViewModel)DataContext).Download,
                                      RelativeSource={RelativeSource AncestorType=views:GameOverviewView}}"
                    CommandParameter="{Binding Model.Id}" />
          </DataTemplate>
        </DataGridTemplateColumn.CellTemplate>
      </DataGridTemplateColumn>

    </DataGrid.Columns>
</DataGrid>


        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Last Sync: " />
                <TextBlock Text="{Binding LastSyncTime}" />
            </StackPanel>
            <!--<Button Grid.Column="0" Content="Download" Command="{Binding Path=StartCommand}" Width="100" Margin="5" HorizontalAlignment="Left"></Button>
                <Button Grid.Column="1" Content="Upload" Command="{Binding Path=StartCommand}" Width="100"  Margin="5" HorizontalAlignment="Center"></Button>-->
            <!-- <Button Grid.Column="1" Content="Sync" Command="{Binding Path=Start}" Width="100" Margin="5" HorizontalAlignment="Right" ></Button> -->
        </Grid>
    </Grid>
</UserControl>
